# Токен бота от @BotFather
BOT_TOKEN=

# Куда слать заявки. Узнать ID: напишите боту /id в нужном чате
ADMIN_CHAT_ID=

# Название компании, от лица которой говорит бот
BUSINESS_NAME=Автосервис «Мотор»
# Первое сообщение после /start
GREETING=Здравствуйте! Это бот автосервиса «Мотор». Подскажу цены и сроки и запишу вас. Спросите своими словами или выберите кнопку ниже.

# Нейросеть: gigachat, openai или fake (тест без ключей)
LLM_PROVIDER=gigachat

# GigaChat: ключ авторизации из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Имя модели: список выведет python check_models.py. Если оставить пустым, возьмётся первая доступная
GIGACHAT_MODEL=
# false — для демо. Для боевого запуска установите сертификат НУЦ Минцифры и включите true
GIGACHAT_VERIFY_SSL=false

# Любой OpenAI-совместимый API (YandexGPT, OpenAI и т. п.), если LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
